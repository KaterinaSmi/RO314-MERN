<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shopping List</title>
</head>
<body>
    <h1><%- heading %></h1>
    <ul>
      <% for (let i = 0; i < listItem.length; i++) { %>
        <% if (listItem[i] === "Bread") { %>
            <li style="color: yellow;"><%- listItem[i] %></li>
        <% } else { %>
            <li><%- listItem[i] %></li>
        <% } %>
      <% } %>
    </ul>
</body>
</html>
